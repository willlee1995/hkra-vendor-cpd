# Repo-local Cloudflare deploy credentials (gitignored).
# Copy to .env.cloudflare and fill in values from:
# https://dash.cloudflare.com/profile/api-tokens
#
# Suggested token permissions for this repo:
#   - Account / Workers Scripts / Edit
#   - Account / Workers Routes / Edit (if using custom routes)
#   - Account / Workers Tail / Read (optional, for wrangler tail)
#
# Do NOT commit .env.cloudflare.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
