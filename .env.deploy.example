# Copy to .env.deploy in the repo root (gitignored). Loaded automatically by deploy scripts.
# Do NOT commit .env.deploy — it may contain your VPS address and SSH paths.

# --- deploy-functions-vps.ps1 (from your PC to VPS) ---
SSH_TARGET=deploy@your.vps.ip
# SSH_KEY=C:\Users\you\.ssh\id_ed25519
# Or split user/host instead of SSH_TARGET:
# VPS_USER=deploy
# VPS_HOST=your.vps.ip

DOCKER_CONTAINER=supabase-edge-functions
FUNCTIONS_PATH=/home/deno/functions
REMOTE_EDGE_FUNCTIONS_DIR=/tmp/hkra-edge-functions

# --- run-migrations-vps.ps1 (Postgres on VPS) ---
POSTGRES_CONTAINER=supabase-db
# Use supabase_admin when public tables are owned by supabase_admin (typical self-hosted Supabase)
POSTGRES_USER=supabase_admin
POSTGRES_DB=postgres
# Or connect locally / via tunnel without SSH:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres

# --- deploy-functions.sh (on the VPS, optional) ---
# SUPABASE_URL=https://supabase.hkra.org.hk
